/*
    gperf source of the assembly syntax keywords, regenerate parser_keywords.c with:
    python scripts/gperf.py src/parser_keywords.gperf
*/

#include "spasm/parser_keywords.h"
#include "spasm/operand.h"

#include <string.h>
%}
%language=ANSI-C
%struct-type
%omit-struct-type
%readonly-tables
%global-table
%pic
%ignore-case
%compare-strncmp
%define hash-function-name spasm_parser_keyword_hash
%define lookup-function-name spasm_parser_keyword_lookup
%define string-pool-name spasm_parser_keyword_strings
%define word-array-name spasm_parser_keyword_words
%define constants-prefix SPASM_PARSER_KEYWORD_
struct SpasmParserKeyword;
%%
.text, SpasmParserKeywordKind_Directive, SpasmParserDirective_Text
.data, SpasmParserKeywordKind_Directive, SpasmParserDirective_Data
