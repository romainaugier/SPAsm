.rdata, SpasmParserKeywordKind_Directive, SpasmParserDirective_RoData
.bss, SpasmParserKeywordKind_Directive, SpasmParserDirective_Bss
.section, SpasmParserKeywordKind_Directive, SpasmParserDirective_Section
.global, SpasmParserKeywordKind_Directive, SpasmParserDirective_Global
.globl, SpasmParserKeywordKind_Directive, SpasmParserDirective_Global
.extern, SpasmParserKeywordKind_Directive, SpasmParserDirective_Extern
.byte, SpasmParserKeywordKind_Directive, SpasmParserDirective_Byte
.word, SpasmParserKeywordKind_Directive, SpasmParserDirective_Word
.short, SpasmParserKeywordKind_Directive, SpasmParserDirective_Word
