.qword, SpasmParserKeywordKind_Directive, SpasmParserDirective_Qword
.quad, SpasmParserKeywordKind_Directive, SpasmParserDirective_Qword
.8byte, SpasmParserKeywordKind_Directive, SpasmParserDirective_Qword
.ascii, SpasmParserKeywordKind_Directive, SpasmParserDirective_Ascii
.asciz, SpasmParserKeywordKind_Directive, SpasmParserDirective_Asciz
.string, SpasmParserKeywordKind_Directive, SpasmParserDirective_Asciz
.zero, SpasmParserKeywordKind_Directive, SpasmParserDirective_Zero
.skip, SpasmParserKeywordKind_Directive, SpasmParserDirective_Zero
.space, SpasmParserKeywordKind_Directive, SpasmParserDirective_Zero
.align, SpasmParserKeywordKind_Directive, SpasmParserDirective_Align
.balign, SpasmParserKeywordKind_Directive, SpasmParserDirective_Align
.p2align, SpasmParserKeywordKind_Directive, SpasmParserDirective_P2Align
.equ, SpasmParserKeywordKind_Directive, SpasmParserDirective_Equ
.set, SpasmParserKeywordKind_Directive, SpasmParserDirective_Equ
.intel_syntax, SpasmParserKeywordKind_Directive, SpasmParserDirective_IntelSyntax
.att_syntax, SpasmParserKeywordKind_Directive, SpasmParserDirective_AttSyntax
byte, SpasmParserKeywordKind_Size, 1
word, SpasmParserKeywordKind_Size, 2
dword, SpasmParserKeywordKind_Size, 4
qword, SpasmParserKeywordKind_Size, 8
xmmword, SpasmParserKeywordKind_Size, 16
oword, SpasmParserKeywordKind_Size, 16
ymmword, SpasmParserKeywordKind_Size, 32
zmmword, SpasmParserKeywordKind_Size, 64
ptr, SpasmParserKeywordKind_Ptr, 0
rn-sae, SpasmParserKeywordKind_Rounding, SpasmRounding_Nearest
rd-sae, SpasmParserKeywordKind_Rounding, SpasmRounding_Down
ru-sae, SpasmParserKeywordKind_Rounding, SpasmRounding_Up
rz-sae, SpasmParserKeywordKind_Rounding, SpasmRounding_Zero
