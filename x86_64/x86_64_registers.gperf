/*
    gperf source of the x86_64 register lookup, regenerate x86_64_registers.c with:
    python x86_64/generate.py --gperf-only
*/

#include "spasm/register.h"

#include <string.h>
%}
%language=ANSI-C
%struct-type
%readonly-tables
%global-table
%pic
%ignore-case
%compare-strncmp
%define hash-function-name spasm_x86_64_register_hash
%define lookup-function-name spasm_x86_64_register_lookup
%define string-pool-name spasm_x86_64_register_strings
%define word-array-name spasm_x86_64_register_words
%define constants-prefix SPASM_X86_64_REGISTER_
struct Spasm_x86_64_RegisterKeyword { int name; uint8_t reg; };
